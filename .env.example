# ── Required ────────────────────────────────────────────
SESSION_SECRET=replace-with-long-random-string

# ── Owner account (seeded on first run if users table is empty) ──
OWNER_NAME=Clay
OWNER_PASSWORD=changeme

# ── iCloud ──────────────────────────────────────────────
# Default works on any Mac with iCloud Drive enabled
NOTES_FOLDER=~/Library/Mobile Documents/com~apple~CloudDocs/Remndrs

# ── Time zone ────────────────────────────────────────────
# IANA name used to stamp notes and fire reminders. Leave blank to use the
# host machine's clock zone; set it (e.g. America/New_York) if your notes
# show the wrong time — typically when the server runs on a Pi/cloud box on
# a different zone than you. Also editable in ⚙ Settings → General.
TIMEZONE=

# ── Twilio (SMS + Voice) ─────────────────────────────────
# Get these from console.twilio.com after creating an account
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The owner's personal phone number (for receiving SMS replies and reminders)
OWNER_PHONE_NUMBER=

# ── OpenAI (Voice transcription) ─────────────────────────
OPENAI_API_KEY=

# ── Mailgun (Email inbound) ───────────────────────────────
MAILGUN_API_KEY=
MAILGUN_SIGNING_KEY=
# The email address inbound messages are routed to, e.g. notes@mg.yourdomain.com
MAILGUN_INBOUND_ADDRESS=

# ── iCloud Calendar (CalDAV) ──────────────────────────────
# Apple ID email address
CALDAV_USERNAME=
# App-specific password — generate at appleid.apple.com → Security → App-Specific Passwords
# Do NOT use your main Apple ID password here
CALDAV_PASSWORD=
# CalDAV server URL for iCloud
CALDAV_URL=https://caldav.icloud.com
# Comma-separated list of calendar display names to sync (set via settings UI)
# Example: CALDAV_CALENDARS=Family,Personal
CALDAV_CALENDARS=

# ── Encryption (generated by setup.sh if missing) ─────────
ENCRYPTION_KEY=

# ── App ──────────────────────────────────────────────────
PORT=3000

# ── Off-box backup (backup.sh) ───────────────────────────
# Used by backup.sh to copy the notes folder + remndrs.db to another machine
# over SSH (e.g. a nightly cron on a Pi → your Mac). See PI_SETUP.md.
# Destination in rsync form: user@host:path  (path is relative to the remote home)
BACKUP_DEST=
# Private key for unattended (cron) SSH. Leave blank to use your default key.
BACKUP_SSH_KEY=
# How many dated DB snapshots to keep on the destination.
BACKUP_KEEP_DB=14
